// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// The only allowed values for an item's status. The database rejects anything else.
enum Status {
  planned
  in_progress
  done
}

// Which part of the Moodboard page an entry belongs to
enum InspirationSection {
  moodboard
  inspiration
}

// A project is the top level. The planned website or app.
// Everything else (items, relationships, tasks, sprints) belongs to a project.
model Project {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  name          String
  // Optional free text about the project (max length is checked by Zod)
  description   String?
  // Key for the project template in code ex "web"
  template      String
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  items         Item[]
  relationships Relationship[]
  tasks         Task[]
  sprints       Sprint[]
  inspirations  ProjectInspiration[]
  colors        ProjectColor[]
  groups        Group[]

  // Fast lookup of a user's projects (also used by every ownership check)
  @@index([userId])
  @@map("projects")
}

// An item are all the building blocks. a page, component, function, data...
model Item {
  id          String         @id @default(uuid()) @db.Uuid
  projectId   String         @map("project_id") @db.Uuid
  type        String
  title       String
  description String?
  status      Status         @default(planned)
  isMvp       Boolean        @default(false) @map("is_mvp")
  positionX   Float          @default(0) @map("position_x")
  positionY   Float          @default(0) @map("position_y")
  // Main photo (for example a Figma screenshot): path in the private Storage bucket, not a URL
  imagePath   String?        @map("image_path")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  // Deleting the project deletes its items
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Two named relations because Relationship points at Item twice:
  // outgoing = connections starting here, incoming = connections ending here
  outgoing    Relationship[] @relation("source")
  incoming    Relationship[] @relation("target")
  tasks       Task[]
  details     ItemDetail[]
  colors      ItemColor[]
  groups      GroupItem[]

  // Lets relationships and tasks point at (id, projectId) together,
  // so the database can check that they are in the same project as the item.
  @@unique([id, projectId])
  // The unique above starts with id, so it doesn't help lookups by projectId
  @@index([projectId])
  @@map("items")
}

// A typed connection between two items (the arrows on the map),
// e.g. "page uses component".
model Relationship {
  id           String  @id @default(uuid()) @db.Uuid
  projectId    String  @map("project_id") @db.Uuid
  // The item the arrow starts from
  sourceItemId String  @map("source_item_id") @db.Uuid
  // The item the arrow points to
  targetItemId String  @map("target_item_id") @db.Uuid
  // What kind of connection it is, ex "uses"
  type         String

  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Deleting an item deletes the connections that start or end at it.
  // projectId is part of both keys, so both items must be in the same project as the relationship.
  source       Item    @relation("source", fields: [sourceItemId, projectId], references: [id, projectId], onDelete: Cascade)
  target       Item    @relation("target", fields: [targetItemId, projectId], references: [id, projectId], onDelete: Cascade)

  // The same two items can't be connected twice with the same type.
  // (The "no connection to itself" rule is added later in the migration SQL.)
  @@unique([sourceItemId, targetItemId, type])
  // sourceItemId is covered by the unique above (first column). These are not.
  @@index([projectId])
  @@index([targetItemId])
  @@map("relationships")
}

// A task is a to-do in the sprint planning.
model Task {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  // Optional. a task can be linked to an item, or stand on its own
  itemId    String? @map("item_id") @db.Uuid
  title     String
  done      Boolean @default(false)
  // Optional. a task may not be in a sprint yet
  sprintId  String? @map("sprint_id") @db.Uuid

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // projectId is part of the key, so a linked item must be in the same project as the task.
  // When itemId is null the database skips the check.
  item      Item?   @relation(fields: [itemId, projectId], references: [id, projectId], onDelete: Cascade)
  // Plain key on purpose: SetNull on a composite key would also null projectId (which is required).
  // The service checks that the sprint is in the same project.
  sprint    Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([itemId])
  @@index([sprintId])
  @@map("tasks")
}

// A sprint groups tasks into a time period, ex "Sprint 1".
model Sprint {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  name      String

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([projectId])
  @@map("sprints")
}

// A detail row on an item, ex a link and a note on the tech stack item "Prisma".
// No projectId: a detail always belongs to one item, and its project is the item's project.
// Ownership is checked through the item (item -> project -> userId).
model ItemDetail {
  id        String   @id @default(uuid()) @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  title     String
  // Both optional: a row can be created with only a title and filled in later
  url       String?
  text      String?
  // Optional image (a moodboard reference card): path in the private Storage bucket, not a URL
  imagePath String?  @map("image_path")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Deleting the item deletes its details
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("item_details")
}

// Inspiration for the whole project (links and notes). Not part of progress.
model ProjectInspiration {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  title     String
  url       String?
  text      String?
  // Moodboard or Inspiration on the Moodboard page. Both can hold text, images and links.
  section   InspirationSection @default(moodboard)
  // Path of the image inside the private Supabase Storage bucket (not a URL). Null = no image.
  // The text field doubles as the image description.
  imagePath String?  @map("image_path")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Deleting the project deletes its inspiration
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_inspirations")
}

// A user-made group of items, ex "Navigation" with the components Nav, Header and Footer.
// Not an item type: an item keeps its type and can be in several groups (or none).
model Group {
  id          String      @id @default(uuid()) @db.Uuid
  projectId   String      @map("project_id") @db.Uuid
  name        String
  // Optional short text about the group (max length is checked by Zod)
  description String?
  // "#RRGGBB", one of the template's groupColors (checked by Zod and the groups service)
  color       String
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  // Deleting the project deletes its groups
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items       GroupItem[]

  // Lets GroupItem point at (id, projectId) together, same idea as on Item
  @@unique([id, projectId])
  @@index([projectId])
  @@map("groups")
}

// Join table: one row = "this item is in this group". Many-to-many between groups and items.
model GroupItem {
  groupId   String @map("group_id") @db.Uuid
  itemId    String @map("item_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid

  // projectId is part of both keys, so the group and the item must be in the same project.
  // Deleting a group (or an item) deletes only these rows, never the item (or the group).
  group     Group  @relation(fields: [groupId, projectId], references: [id, projectId], onDelete: Cascade)
  item      Item   @relation(fields: [itemId, projectId], references: [id, projectId], onDelete: Cascade)

  // An item can only be in the same group once. groupId is covered by this (first column).
  @@id([groupId, itemId])
  @@index([itemId])
  @@map("group_items")
}

// A color in the project's palette (for example #3E6554). Items can link to these colors later.
model ProjectColor {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  // Always "#RRGGBB" in upper case (checked by Zod)
  hex       String
  // Optional label, for example "Primary green"
  name      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Deleting the project deletes its palette
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  itemColors ItemColor[]

  // Lets item_colors point at (id, projectId) together, so an item can only use colors of its own project
  @@unique([id, projectId])
  // The unique above starts with id, so it doesn't help lookups by projectId
  @@index([projectId])
  @@map("project_colors")
}

// A link between an item and a color in the project's palette (one row per color the item uses).
model ItemColor {
  itemId    String @map("item_id") @db.Uuid
  colorId   String @map("color_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid

  // projectId is part of both keys, so the item and the color must be in the same project.
  // Deleting the item or the color deletes the link.
  item  Item         @relation(fields: [itemId, projectId], references: [id, projectId], onDelete: Cascade)
  color ProjectColor @relation(fields: [colorId, projectId], references: [id, projectId], onDelete: Cascade)

  // An item can use a color only once. itemId is the first column, so it is indexed by this.
  @@id([itemId, colorId])
  // colorId and projectId are not first columns of another index
  @@index([colorId])
  @@index([projectId])
  @@map("item_colors")
}
